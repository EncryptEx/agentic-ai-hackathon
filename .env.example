# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# ---------------------------------------------------------------------------
# EvidenceTrail (investigator, Jev triage, G-Eval judge, ADK hand-off)
# Copy this file to .env (gitignored) and fill in the keys. Real environment
# variables win over .env. Keys stay server-side; they are never sent to the
# browser or written to traces or exports.
# ---------------------------------------------------------------------------
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# EvidenceTrail's agents and the G-Eval judge use this key. For the ADK hand-off
# to use the same key, also set GOOGLE_GENAI_USE_VERTEXAI=false at the top.
GEMINI_API_KEY=
# TypeSafe Jev key (https://console.typesafe.ai/keys): risk judge and alert triage.
TYPESAFE_API_KEY=
# Optional overrides:
# EVIDENCETRAIL_GEMINI_MODEL=gemini-3.8-flash
# EVIDENCETRAIL_JEV_MODEL=jev-latest
# EVIDENCETRAIL_ALERT_DB=data/evidencetrail.db

# Context reduction keeps exact facts and uses bounded transaction evidence pages.
# Set to 0 for a baseline with the original ADK histories and Interactions formatting.
CONTEXT_REDUCTION_ENABLED=1
# Optional condense.chat direct compression. Requires the account's compress capability.
# Add the real key only to .env. Missing keys/outages fall back to original prose.
CONDENSE_ENABLED=0
CONDENSE_API_KEY=
CONDENSE_MODEL=helene-1
# Target fraction removed from ELIGIBLE prose, not the whole investigation.
CONDENSE_COMPRESSION_RATE=0.6
CONDENSE_MIN_CHARS=1200
CONDENSE_TIMEOUT_SECONDS=8
